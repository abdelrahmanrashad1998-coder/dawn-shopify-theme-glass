{% doc %}
  @prompt
    glass featured collection
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glass-collection-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px;
  }

  .ai-glass-collection-container-{{ ai_gen_id }} {
    background: rgba(255, 255, 255, {{ block.settings.glass_opacity }});
    backdrop-filter: blur({{ block.settings.glass_blur }}px);
    -webkit-backdrop-filter: blur({{ block.settings.glass_blur }}px);
    border: {{ block.settings.glass_border_thickness }}px solid rgba(255, 255, 255, {{ block.settings.glass_border_opacity }});
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.container_padding }}px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
  }

  .ai-glass-collection-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 30px;
  }

  .ai-glass-collection-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
    font-weight: 600;
  }

  .ai-glass-collection-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-glass-collection-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-glass-collection-item-{{ ai_gen_id }} {
    background: rgba(255, 255, 255, {{ block.settings.card_glass_opacity }});
    backdrop-filter: blur({{ block.settings.card_glass_blur }}px);
    -webkit-backdrop-filter: blur({{ block.settings.card_glass_blur }}px);
    border: 1px solid rgba(255, 255, 255, {{ block.settings.card_border_opacity }});
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-glass-collection-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, {{ block.settings.card_hover_shadow }});
  }

  .ai-glass-collection-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
  }

  .ai-glass-collection-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-glass-collection-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(244, 244, 244, 0.5);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-glass-collection-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-glass-collection-info-{{ ai_gen_id }} {
    padding: 20px;
    text-align: center;
  }

  .ai-glass-collection-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 500;
  }

  .ai-glass-collection-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 600;
  }

  .ai-glass-collection-button-{{ ai_gen_id }} {
    display: inline-block;
    margin-top: 30px;
    padding: 12px 30px;
    background: rgba(255, 255, 255, {{ block.settings.button_glass_opacity }});
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: {{ block.settings.button_border_radius }}px;
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: 16px;
    transition: all 0.3s ease;
  }

  .ai-glass-collection-button-{{ ai_gen_id }}:hover {
    background: rgba(255, 255, 255, {{ block.settings.button_hover_opacity }});
    transform: translateY(-2px);
  }

  .ai-glass-collection-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.description_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-glass-collection-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-glass-collection-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-glass-collection-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-glass-collection-container-{{ ai_gen_id }} {
      padding: {{ block.settings.container_padding | times: 0.6 }}px;
    }
  }
{% endstyle %}

<glass-collection-{{ ai_gen_id }} class="ai-glass-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-glass-collection-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.description != blank %}
      <div class="ai-glass-collection-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-glass-collection-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-glass-collection-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.collection != blank %}
      <div class="ai-glass-collection-grid-{{ ai_gen_id }}">
        {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
          <div class="ai-glass-collection-item-{{ ai_gen_id }}">
            <a href="{{ product.url }}">
              <div class="ai-glass-collection-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-glass-collection-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-glass-collection-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-glass-collection-info-{{ ai_gen_id }}">
                <h3 class="ai-glass-collection-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                <div class="ai-glass-collection-product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>

      {% if block.settings.show_view_all and block.settings.collection.url %}
        <div style="text-align: {{ block.settings.text_alignment }};">
          <a href="{{ block.settings.collection.url }}" class="ai-glass-collection-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="ai-glass-collection-empty-{{ ai_gen_id }}">
        <p>Select a collection to display products</p>
      </div>
    {% endif %}
  </div>
</glass-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class GlassCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initGlassEffect();
      }

      initGlassEffect() {
        const items = this.querySelectorAll('.ai-glass-collection-item-{{ ai_gen_id }}');
        items.forEach(item => {
          item.addEventListener('mouseenter', function() {
            this.style.transition = 'all 0.3s ease';
          });
        });
      }
    }

    customElements.define('glass-collection-{{ ai_gen_id }}', GlassCollection{{ ai_gen_id }});
  })();
</script>

